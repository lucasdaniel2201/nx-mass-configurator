<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NxMassConfigurator.Core</AssemblyName>
    <RootNamespace>NxMassConfigurator</RootNamespace>
    <Version>2.0.0</Version>
    <InformationalVersion>2.0.0</InformationalVersion>
    <FileVersion>2.0.0</FileVersion>
    <Authors>HOW BE Tecnologia</Authors>
    <Description>Biblioteca de configuracao massiva de cameras NX Witness</Description>
    <Copyright>2026 HOW BE Tecnologia e Soluções LTDA</Copyright>

    <!-- GitHub repo for auto-update -->
    <RepositoryUrl>https://github.com/lucasdaniel2201/nx-mass-configurator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Octokit" Version="13.0.1" />
    <PackageReference Include="SMBLibrary" Version="1.5.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
