<Window x:Class="NxMassConfigurator.Wpf.Views.ServerInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adicionar Servidor NAS"
        Width="350" Height="150"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Endereço IP do servidor NAS QNAP:" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <TextBox x:Name="IpTextBox" Grid.Row="1" 
                 Text="10.81.5." 
                 FontFamily="Consolas" FontSize="14"
                 Height="32"/>

        <UniformGrid Grid.Row="2" Columns="2" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" IsCancel="True" Width="90" Margin="0,0,8,0"/>
            <Button Content="Adicionar" IsDefault="True" Width="90"
                    Style="{StaticResource PrimaryButton}"
                    Click="Add_Click"/>
        </UniformGrid>
    </Grid>
</Window>
